{
  "name": "@mogu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/server.ts --format esm --out-dir dist --no-splitting",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "hono": "4.13.22",
    "@hono/node-server": "2.1.11",
    "@mogu/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "tsup": "9.0.0",
    "@mogu/config": "workspace:*"
  }
}
