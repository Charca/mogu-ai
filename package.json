{
  "name": "mogu-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @mogu/mobile dev",
    "dev:api": "pnpm --filter @mogu/api dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "2.11.13",
    "typescript": "~6.0.3",
    "vitest": "5.1.2",
    "prettier": "3.10.1",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "8.74.0",
    "@types/node": "^24.0.0"
  },
  "type": "module"
}
